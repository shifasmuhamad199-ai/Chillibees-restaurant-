    <footer>
        <div class="contact-info">
            <p><strong style="color: #ff6600;">CHILLIBEES RESTAURANT</strong></p>
            <p>📞 +974 5597 7712</p>
            <p class="hours">🕒 Opening Hours: 10:00 AM - 11:00 PM</p>
        </div>
        <p>&copy; 2024 CHILLIBEES RESTAURANT. All rights reserved.</p>
    </footer>
</body>
</html>
